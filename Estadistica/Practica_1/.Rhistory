rm(list=ls())
#'
#'
#' ### La función plot
#'
#' Ver [Sección 3.1 ](https://rubenfcasal.github.io/intror/funcion-plot.html).
#'
#' Si ejecutamos `plot(x, y)` siendo `x` e `y` vectores, entonces `R` generará el
#' denominado **gráfico de dispersión** que representa en un sistema coordenado los
#' pares de valores $(x,y)$.
#'
x <- seq(0, 2 * pi, length = 100)
y <- cos(x)
plot(x, y, type = "l", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "12", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "b", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "n", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "b", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "l", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "l", col = 2, lwd = 100, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "l", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
plot(x, y, type = "l", pch = "1", col = 2, lwd = 3, ylab = "cos(x)", main = "Coseno en [0,2pi]")
